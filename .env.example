# Copy to .env (gitignored) and fill in. The key file itself must live OUTSIDE this repo.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/sa-key.json
# Per-tenant key (tenant YAML google_credentials_env names this variable; used by conholdate.cloud)
GOOGLE_CREDENTIALS_HEALTH_AND_RECOVERY=/absolute/path/outside/repo/other-sa-key.json
TENANT=aspose.app
# Optional: PageSpeed Insights API key. Without it, audit_perf.py uses the service account above
# (the PageSpeed Insights API must be enabled in its Cloud project).
# PAGESPEED_API_KEY=
# Internal LLM (OpenAI-compatible endpoint) for judgment checks such as spelling in titles and H1s.
PROFESSIONALIZE_API_KEY=
PROFESSIONALIZE_BASE_URL=
PROFESSIONALIZE_LLM_MODEL=
